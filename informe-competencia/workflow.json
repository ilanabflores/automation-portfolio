    {
      "parameters": {
        "jsCode": "/* Filtra hallazgos relevantes del ciclo actual, calcula KPIs\n   (crítica/alta/media/baja) y arma el prompt para Gemini.\n   Devuelve un único item con { fecha, total, critica, alta, media, baja, items, prompt }.\n   Si la ejecución es automática y ya se procesó esta fecha, devuelve []. */\nconst rows = $input.all().map(i => i.json);\n// ... (lógica de filtrado y construcción de prompt)\nreturn [{ json: { fecha: '', total: rows.length, critica: 0, alta: 0, media: 0, baja: 0, items: [], prompt: '' } }];"
      },
      "id": "177ea90b-2934-4666-9bcf-23cb5a797508",
      "name": "Preparar datos",
