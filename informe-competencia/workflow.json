    {
      "parameters": {
        "jsCode": "/* Construye el HTML completo del informe:\n   - Cabecera oscura con fecha del ciclo y métricas\n   - 4 tarjetas KPI (total páginas, amenazas altas, medias, sin cambios)\n   - Barra de distribución proporcional por nivel\n   - Resumen ejecutivo (texto de Gemini)\n   - Radar de competidores (grid 5 columnas con logo + nivel)\n   - Hallazgos con comparación frente al producto propio\n   - Panorama de mercado con gráfico de barras y cifras clave\n   - Recomendaciones ordenadas por prioridad\n   Devuelve { subject, html (inline para el body del email), htmlFile (con logos embebidos en base64 para el adjunto) } */\nreturn [{ json: { subject: 'Informe de competencia - ', html: '', htmlFile: '' } }];"
      },
      "id": "3e7ee01d-2867-42d7-b883-fdd391416711",
      "name": "Armar informe HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 304]
    },
    {
      "parameters": {
        "jsCode": "/* Convierte htmlFile a binario y lo adjunta como archivo .html\n   para que pueda enviarse como adjunto en el email. */\nreturn [{ json: { subject: $json.subject, html: $json.html }, binary: { informe: {} } }];"
      },
      "id": "e4fba14d-c9da-46af-8dc7-8575204bbbd5",
      "name": "Adjuntar archivo",
