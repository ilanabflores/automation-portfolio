      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "/* Comprueba si el ciclo actual ya fue enviado comparando\n   la fecha del Preparar datos con las filas de informes_enviados.\n   Si ya existe o no hay hallazgos y no es prueba manual, devuelve [].\n   En prueba manual, deja pasar siempre. */\nreturn [{ json: $('Preparar datos').first().json }];"
      },
